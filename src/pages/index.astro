---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import BookCard from "../components/BookCard.astro";
import Sparkle from "../components/Sparkle.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import type { BookMediaField } from "../types/books";

const AMAZON_AUTHOR_URL =
	"https://www.amazon.com/stores/Mary-Malcarne/author/B0B4TY6R7Z";

const [{ entries: books, cacheHint: booksHint }, aboutResult, settings] =
	await Promise.all([
		// series_position is ascending, so this is reading order: prequel, 1, 2...
		getEmDashCollection("books", {
			orderBy: { series_position: "asc" },
			limit: 12,
		}),
		getEmDashEntry("pages", "about"),
		getSiteSettings(),
	]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
// `photo` is added to the pages collection in the production database, so it is
// not in the generated local `Page` type.
const authorPhoto =
	(aboutResult.entry?.data as { photo?: BookMediaField } | undefined)?.photo ??
	null;
const series = books[0]?.data.series ?? "The Final Strand";

if (Astro.cache?.enabled) {
	Astro.cache.set(booksHint);
	Astro.cache.set(aboutResult.cacheHint);
}
---

<Base title={siteTitle} description={siteTagline}>
	<div class="landing">
		<section class="hero">
			<div class="hero-wash" aria-hidden="true" />
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">
						<Sparkle size="0.8em" /> Author of <em>{series}</em>
						<Sparkle size="0.8em" />
					</p>
					<h1 class="hero-title">{siteTitle}</h1>
					<p class="hero-tagline">{siteTagline}</p>
					<div class="hero-actions">
						<a href="/books" class="btn btn-primary">Read the series</a>
						<a
							href={AMAZON_AUTHOR_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-ghost"
						>
							All books on Amazon
						</a>
					</div>
					{
						books.length > 1 && (
							<p class="hero-note">
								{books.length} books, best read in order — starting with a storm.
							</p>
						)
					}
				</div>
				{
					authorPhoto && (
						<div class="hero-portrait">
							<div class="portrait-frame">
								<Image image={authorPhoto} />
							</div>
							<span class="portrait-sparkle portrait-sparkle-1">
								<Sparkle size="1.6rem" />
							</span>
							<span class="portrait-sparkle portrait-sparkle-2">
								<Sparkle size="1rem" />
							</span>
							<span class="portrait-sparkle portrait-sparkle-3">
								<Sparkle size="0.7rem" />
							</span>
						</div>
					)
				}
			</div>
		</section>

		{
			books.length === 0 ? (
				<section class="empty-state">
					<h2>No books yet</h2>
					<p>Add a book in the admin panel to see it here.</p>
					<a href="/_emdash/admin/content/books/new" class="btn btn-primary">
						Add a book
					</a>
				</section>
			) : (
				<section class="books" id="books">
					<header class="section-head">
						<h2 class="section-title">The Books</h2>
						{books[0]?.data.series && (
							<p class="section-sub">{books[0].data.series}</p>
						)}
					</header>
					<div class="book-grid">
						{books.map((book) => (
							<BookCard book={book.data} edit={book.edit} />
						))}
					</div>
					<p class="order-note">
						Best read in order — {books
							.map((book) => book.data.title)
							.join(", then ")}.
					</p>
				</section>
			)
		}

		<section class="about-teaser">
			<div class="teaser-inner">
				<h2 class="section-title">About Mary</h2>
				<p class="teaser-body">
					Emotionally immersive stories threaded with longing, memory, romance, and
					quiet magic.
				</p>
				<a href="/pages/about" class="btn btn-ghost">Learn more</a>
			</div>
		</section>
	</div>
</Base>

<style>
	.landing {
		display: flex;
		flex-direction: column;
	}

	/* Flex items default to a min-content floor; without this the book grid's
	   max-content width overflows narrow viewports. */
	.landing > * {
		min-width: 0;
	}

	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.hero-wash {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(
				ellipse 70% 60% at 20% 0%,
				var(--color-wash) 0%,
				transparent 70%
			),
			radial-gradient(
				ellipse 50% 50% at 90% 20%,
				var(--color-wash) 0%,
				transparent 70%
			);
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: center;
		gap: var(--spacing-16);
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-24) var(--spacing-6);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-4);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-text-secondary);
	}

	.hero-title {
		font-size: clamp(3rem, 8vw, var(--font-size-5xl));
		font-weight: var(--font-weight-display);
		line-height: 1.02;
		letter-spacing: var(--tracking-tight);
	}

	.hero-tagline {
		max-width: 34ch;
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-2);
	}

	.hero-note {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		padding: var(--spacing-3) var(--spacing-6);
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.btn-primary {
		background: var(--color-brand);
		border: 1px solid var(--color-brand);
		color: var(--color-on-brand);
	}

	.btn-primary:hover {
		background: var(--color-brand-hover);
		border-color: var(--color-brand-hover);
		color: var(--color-on-brand);
		transform: translateY(-1px);
	}

	.btn-ghost {
		background: transparent;
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.btn-ghost:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	/* Author portrait */
	.hero-portrait {
		position: relative;
		justify-self: center;
		max-width: 340px;
	}

	.portrait-frame {
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--color-surface);
		box-shadow: var(--shadow-lg);
		/* A soft warm ring, like an illustrated frame. */
		border: 1px solid var(--color-border-subtle);
	}

	.portrait-frame :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
	}

	.portrait-sparkle {
		position: absolute;
		color: var(--color-sparkle);
		pointer-events: none;
	}

	.portrait-sparkle-1 {
		top: -0.75rem;
		right: -0.5rem;
	}

	.portrait-sparkle-2 {
		bottom: 12%;
		left: -1rem;
	}

	.portrait-sparkle-3 {
		top: 38%;
		right: -1.5rem;
	}

	/* Books */
	.books {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-24) var(--spacing-6) var(--spacing-16);
	}

	.section-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-12);
		text-align: center;
	}

	.section-title {
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
	}

	.section-sub {
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-brand);
	}

	/* min() keeps the minimum track from exceeding a narrow container. */
	.book-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
		gap: var(--spacing-12) var(--spacing-8);
		max-width: 900px;
		margin: 0 auto;
	}

	.order-note {
		margin-top: var(--spacing-12);
		text-align: center;
		font-size: var(--font-size-sm);
		font-style: italic;
		color: var(--color-muted);
	}

	/* About teaser */
	.about-teaser {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border-subtle);
	}

	.teaser-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-4);
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-20) var(--spacing-6);
		text-align: center;
	}

	.teaser-body {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* Empty state */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
	}

	.empty-state p {
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.hero-inner {
			grid-template-columns: 1fr;
			gap: var(--spacing-12);
			padding: var(--spacing-16) var(--spacing-5);
			text-align: center;
		}

		.hero-copy {
			align-items: center;
		}

		.hero-portrait {
			order: -1;
			max-width: 240px;
		}

		.hero-tagline {
			max-width: none;
		}

		.books {
			padding: var(--spacing-16) var(--spacing-5);
		}

		.section-title {
			font-size: var(--font-size-2xl);
		}
	}
</style>
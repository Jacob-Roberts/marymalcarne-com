{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marymalcarne-com",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marymalcarne-com","database_id": "40dd77ad-f973-4b49-8ac5-ee34acba1686",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "marymalcarne-com","preview_bucket_name": "marymalcarne-com",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"routes": [{ "pattern": "marymalcarne.com", "custom_domain": true }],
}

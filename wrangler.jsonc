{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marymalcarne-com",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marymalcarne-com","database_id": "40dd77ad-f973-4b49-8ac5-ee34acba1686",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "marymalcarne-com","preview_bucket_name": "marymalcarne-com",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Optional: KV namespace for EmDash's object cache (reduces D1 reads).
	// Create it with: npx wrangler kv namespace create CACHE
	// Then replace the placeholder id below and uncomment.
	"kv_namespaces": [
	   { "binding": "CACHE", "id": "fbe5c77a6ee24efe89bcb8fd8433fa7f" }
	],
	// Keep cached pages across deploys so a deploy doesn't wipe the edge cache.
	"cache": { "enabled": true, "cross_version_cache": true },
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"routes": [{ "pattern": "marymalcarne.com", "custom_domain": true }],
}
